<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppoloPocket" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/deep_night</item>
        <item name="android:navigationBarColor">@color/deep_night</item>
        <item name="android:windowBackground">@color/deep_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.AppoloPocket.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AppoloPocket</item>
    </style>
</resources>
